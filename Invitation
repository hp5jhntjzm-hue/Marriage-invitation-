*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{

background:#f8f3ea;

font-family:Poppins,sans-serif;

color:#3a2b17;

overflow-x:hidden;

}

h1,h2,h3{

font-family:Cinzel,serif;

}

#intro{

position:fixed;

width:100%;

height:100vh;

overflow:hidden;

background:#111;

display:flex;

justify-content:center;

align-items:center;

z-index:9999;

}

.intro-content{

position:absolute;

text-align:center;

color:white;

z-index:2;

}

.intro-content h1{

font-size:55px;

margin-bottom:20px;

color:#d4af37;

}

#openBtn{

padding:16px 40px;

border:none;

background:#d4af37;

color:white;

border-radius:40px;

cursor:pointer;

font-size:18px;

}

.door{

position:absolute;

width:50%;

height:100%;

background:linear-gradient(90deg,#8b6b18,#d4af37,#8b6b18);

transition:2s;

}

.left{

left:0;

}

.right{

right:0;

}

.open-left{

transform:translateX(-100%);

}

.open-right{

transform:translateX(100%);

}

.hero{

height:100vh;

background:url("assets/hero.jpg") center/cover;

display:flex;

align-items:center;

justify-content:center;

position:relative;

}

.overlay{

background:rgba(0,0,0,.45);

padding:50px;

border-radius:20px;

text-align:center;

color:white;

}

.overlay h2{

font-size:55px;

color:#d4af37;

}

.overlay span{

font-size:45px;

display:block;

margin:15px;

}

section{

padding:70px 8%;

text-align:center;

}

#timer{

display:flex;

justify-content:center;

flex-wrap:wrap;

gap:20px;

margin-top:30px;

}

#timer div{

background:white;

padding:25px;

border-radius:15px;

box-shadow:0 10px 25px rgba(0,0,0,.1);

min-width:110px;

}

#timer span{

display:block;

font-size:35px;

color:#c89b2d;

font-weight:bold;

}

.details{

background:#fffdf8;

}

.card{

max-width:450px;

margin:20px auto;

padding:25px;

background:white;

border-left:5px solid gold;

border-radius:15px;

box-shadow:0 10px 25px rgba(0,0,0,.08);

}

.gallery .grid{

display:grid;

grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

gap:20px;

margin-top:30px;

}

.gallery img{

width:100%;

border-radius:15px;

transition:.5s;

}

.gallery img:hover{

transform:scale(1.05);

}

iframe{

width:100%;

height:350px;

margin-top:25px;

border:none;

border-radius:15px;

}

.map-btn{

display:inline-block;

padding:15px 35px;

background:#d4af37;

color:white;

border-radius:40px;

text-decoration:none;

margin-top:20px;

}

footer{

padding:40px;

text-align:center;

background:#d4af37;

color:white;

}

#musicBtn{

position:fixed;

right:20px;

bottom:20px;

background:#d4af37;

border:none;

padding:15px;

border-radius:50%;

cursor:pointer;

z-index:500;

}

.flower{

position:fixed;

top:-50px;

font-size:22px;

animation:fall linear forwards;

pointer-events:none;

}

@keyframes fall{

to{

transform:translateY(110vh) rotate(360deg);

opacity:0;

}

}

@media(max-width:768px){

.overlay h2{

font-size:38px;

}

.intro-content h1{

font-size:40px;

}

}
const intro=document.getElementById("intro");

const left=document.querySelector(".left");

const right=document.querySelector(".right");

document.getElementById("openBtn").onclick=()=>{

left.classList.add("open-left");

right.classList.add("open-right");

setTimeout(()=>{

intro.style.display="none";

},1800);

};

const audio=document.getElementById("music");

const musicBtn=document.getElementById("musicBtn");

let playing=false;

musicBtn.onclick=()=>{

if(playing){

audio.pause();

playing=false;

musicBtn.innerHTML="♪ Musique";

}else{

audio.play();

playing=true;

musicBtn.innerHTML="❚❚";

}

};

const target=new Date("December 17, 2026 15:00:00").getTime();

setInterval(()=>{

const now=new Date().getTime();

const diff=target-now;

document.getElementById("days").innerHTML=Math.floor(diff/(1000*60*60*24));

document.getElementById("hours").innerHTML=Math.floor(diff%(1000*60*60*24)/(1000*60*60));

document.getElementById("minutes").innerHTML=Math.floor(diff%(1000*60*60)/(1000*60));

document.getElementById("seconds").innerHTML=Math.floor(diff%(1000*60)/1000);

},1000);

function flower(){

const f=document.createElement("div");

f.className="flower";

f.innerHTML=["🌸","🌹","🌺","💮"][Math.floor(Math.random()*4)];

f.style.left=Math.random()*100+"vw";

f.style.animationDuration=(4+Math.random()*5)+"s";

document.body.appendChild(f);

setTimeout(()=>{

f.remove();

},9000);

}

setInterval(flower,450);
